<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

        <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RotateMeetTheme"
        tools:targetApi="31">

        <meta-data
            android:name="com.pico.spatial.SPATIAL_APP"
            android:value="true" />
        <meta-data
            android:name="pico.spatial.isspatial"
            android:value="1" />
        <meta-data
            android:name="pico.spatial.sdk_version_string"
            android:value="6.0.0" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.RotateMeetTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Progressive immersive Stage. The user can reduce immersion without losing the
                 central control panel or the real-world safety context. -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="IslandAirControlStage" />
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="82" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="55" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />
        </activity>
        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
